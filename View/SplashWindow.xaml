<Window x:Class="GuiPiao.View.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:GuiPiao.Icons"
        Title="启动中"
        Width="420"
        Height="240"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{x:Static icons:AppIcons.PageList}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="36"
                           Foreground="{DynamicResource AccentForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14" />
                <TextBlock Text="火车票管理系统"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="GuiPiao"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>

            <ProgressBar Grid.Row="1"
                         Margin="0,8,0,10"
                         IsIndeterminate="True" />

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Text="正在启动…"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </Grid>
    </Border>
</Window>
