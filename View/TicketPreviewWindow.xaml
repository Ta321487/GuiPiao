<Window x:Class="GuiPiao.View.TicketPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GuiPiao.ViewModel"
        xmlns:model="clr-namespace:GuiPiao.Model"
        xmlns:converters="clr-namespace:GuiPiao.Converters"
        xmlns:controls="clr-namespace:GuiPiao.View.Controls"
        xmlns:hit="clr-namespace:GuiPiao.View"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1100"
        Height="700"
        MinWidth="720"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="TicketPreviewWindow_PreviewKeyDown"
        PreviewKeyUp="TicketPreviewWindow_PreviewKeyUp"
        Deactivated="TicketPreviewWindow_Deactivated">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/AppConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <converters:LayoutFontFamilyMultiConverter x:Key="LayoutFontFamilyMultiConverter" />
        <converters:TicketLayoutIsolationToVisibilityConverter x:Key="TicketLayoutIsolationToVisibilityConverter" />
        <!-- 票种/支付简字：带框与无框共用一套视觉 -->
        <DataTemplate x:Key="TicketBadgeGlyphVisual">
            <Grid>
                <Border Width="{Binding DataContext.TicketBadgeSlotWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="{Binding DataContext.TicketBadgeSlotWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        Padding="0" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.2"
                        CornerRadius="{Binding DataContext.BadgeCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding DataContext.ShowFramedTicketBadges, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TicketVoucherPrimaryTextBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="{Binding DataContext.ActiveLayout.BadgeFont, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock.FontFamily>
                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                <Binding Path="DataContext.ActiveLayout.BadgeFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                            </MultiBinding>
                        </TextBlock.FontFamily>
                    </TextBlock>
                </Border>
                <TextBlock Text="{Binding}" Foreground="{DynamicResource TicketVoucherPrimaryTextBrush}" FontWeight="SemiBold"
                           Width="{Binding DataContext.TicketBadgeSlotWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextAlignment="Center"
                           FontSize="{Binding DataContext.ActiveLayout.BadgeFont, RelativeSource={RelativeSource AncestorType=Window}}"
                           Visibility="{Binding DataContext.ShowFramedTicketBadges, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock.FontFamily>
                        <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                            <Binding Path="DataContext.ActiveLayout.BadgeFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </TextBlock.FontFamily>
                </TextBlock>
            </Grid>
        </DataTemplate>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        </Style>
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
        </Style>
        <Style x:Key="FormReadOnly" TargetType="TextBox" BasedOn="{StaticResource FormBox}">
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style x:Key="FormCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsEditable" Value="False" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
        </Style>
        <Style x:Key="WorkbenchFontComboStyle" TargetType="ComboBox" BasedOn="{StaticResource FormCombo}">
            <Setter Property="IsEditable" Value="False" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="SelectedValuePath" Value="Source" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{Binding Source}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="">
                                            <Setter Property="FontFamily" Value="Segoe UI" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.DataContext>
        <vm:TicketPreviewViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 缩放 / 亮度；行程预览可展开侧栏对照信息 -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="缩放" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" />
                    <ComboBox MinWidth="120" MaxWidth="160"
                              IsEditable="False"
                              ItemsSource="{x:Static model:TicketPreviewZoomOptions.ComboItems}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding CurrentZoom}"
                              Margin="0,0,12,0" />
                    <Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource StandardButtonStyle}" MinWidth="28" Margin="0,0,4,0" />
                    <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource StandardButtonStyle}" MinWidth="28" Margin="0,0,12,0" />
                    <TextBlock Text="亮度" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" />
                    <Slider Width="100" Minimum="50" Maximum="150" Value="{Binding Brightness}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Brightness, StringFormat={}{0}%}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Width="36" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Content="{Binding TripInfoPanelToggleText}"
                        Command="{Binding ToggleTripInfoPanelCommand}"
                        Style="{StaticResource StandardButtonStyle}"
                        Padding="10,4"
                        ToolTip="显示或隐藏左侧行程对照信息"
                        Visibility="{Binding ShowTripInfoPanelToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidePanelColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：版式参数（工作台）+ 行程对照 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"
                    Visibility="{Binding IsSidePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding LayoutEditorRowHeight}" />
                        <RowDefinition Height="{Binding TripPanelRowHeight}" />
                    </Grid.RowDefinitions>

                    <!-- 版式编辑区：占满上半，便于调位置/字号 -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6"
                                  Background="{DynamicResource PanelBackgroundBrush}"
                                  Visibility="{Binding IsLayoutWorkbench, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="版式" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <CheckBox Content="可视化编辑" IsChecked="{Binding IsVisualLayoutEdit}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                      ToolTip="在票面上点选并拖动布局元素" />

                            <TextBlock Text="元素" Style="{StaticResource FormLabel}" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding LayoutElementItems}" DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedLayoutElementItem, Mode=TwoWay}" Margin="0,0,0,4" />
                            <CheckBox Content="成组移动" IsChecked="{Binding WorkbenchMoveAsGroup}" Margin="0,0,0,2"
                                      IsEnabled="{Binding EditorShowsMoveAsGroup}"
                                      ToolTip="{Binding WorkbenchMoveGroupToolTip}" />
                            <Button Content="紧贴排布" Margin="0,0,0,8" Padding="8,2" HorizontalAlignment="Left"
                                    Command="{Binding PackBadgeLettersTightCommand}"
                                    Visibility="{Binding EditorShowsBadgePack, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource StandardButtonStyle}"
                                    ToolTip="按占位宽度重排简字与支付简字" />
                            <CheckBox Content="含拼音" IsChecked="{Binding WorkbenchStationGroupIncludesPinyin}" Margin="0,0,0,8"
                                      Visibility="{Binding EditorShowsStationGroupIncludesPinyin, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      ToolTip="站名组成组时包含拼音" />
                            <CheckBox Content="简字边框" IsChecked="{Binding ShowFramedTicketBadges}" Margin="0,0,0,8"
                                      ToolTip="显示票种/支付简字边框" />

                            <TextBlock Text="{Binding EditorAnchorXLabel}" Style="{StaticResource FormLabel}" />
                            <Slider Minimum="0" Maximum="{Binding EditorAnchorXMaximum}"
                                    Value="{Binding EditorAnchorX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding EditorAnchorYLabel}" Style="{StaticResource FormLabel}" />
                            <Slider Minimum="{Binding EditorAnchorYMinimum}" Maximum="{Binding EditorAnchorYMaximum}"
                                    Value="{Binding EditorAnchorY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />

                            <StackPanel Visibility="{Binding EditorShowsFontSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding EditorFontSizeLabel}" Style="{StaticResource FormLabel}" />
                                <Slider Minimum="{Binding EditorFontSizeMinimum}" Maximum="{Binding EditorFontSizeMaximum}"
                                        Value="{Binding EditorFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="复制字号" Command="{Binding CopyWorkbenchFontSizeCommand}" IsEnabled="{Binding CanCopyWorkbenchFontSize}"
                                            Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,6,4"
                                            ToolTip="复制尺寸（Ctrl+C）" />
                                    <Button Content="粘贴字号" Command="{Binding PasteWorkbenchFontSizeCommand}" IsEnabled="{Binding CanPasteWorkbenchFontSize}"
                                            Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,0,4"
                                            ToolTip="粘贴尺寸（Ctrl+V）" />
                                </WrapPanel>
                                <TextBlock Text="{Binding WorkbenchCopiedFontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource SmallFontSize}" Margin="0,0,0,2" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,4"
                                        Visibility="{Binding DepartStationCharacterSpacingAdjustable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="字间距" Style="{StaticResource FormLabel}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding WorkbenchDepartStationLayoutCaption}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource SmallFontSize}" Margin="0,0,0,2" />
                                <Slider Minimum="-120" Maximum="420" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding ActiveDepartStationCharacterSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                        ToolTip="按站名字数分别保存" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,4"
                                        Visibility="{Binding ArriveStationCharacterSpacingAdjustable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="字间距" Style="{StaticResource FormLabel}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding WorkbenchArriveStationLayoutCaption}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource SmallFontSize}" Margin="0,0,0,2" />
                                <Slider Minimum="-120" Maximum="420" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding ActiveArriveStationCharacterSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                        ToolTip="按站名字数分别保存" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding EditorShowsExtraDimension, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding EditorExtraLabel}" Style="{StaticResource FormLabel}" />
                                <Slider Minimum="{Binding EditorExtraMinimum}" Maximum="{Binding EditorExtraMaximum}"
                                        Value="{Binding EditorExtra, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding EditorShowsArrowHeadFineTune, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="箭头尖长度" Style="{StaticResource FormLabel}" />
                                <Slider Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding EditorArrowHeadLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                        ToolTip="0 = 自动" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding EditorShowsFontFamily, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="字体" Style="{StaticResource FormLabel}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Style="{StaticResource WorkbenchFontComboStyle}"
                                              ItemsSource="{Binding EditorFontPickerItems}"
                                              SelectedValue="{Binding EditorFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', FallbackValue=''}"
                                              ToolTip="当前元素字体；空值继承默认字体" />
                                    <Button Grid.Column="1" Content="系统…" VerticalAlignment="Center"
                                            Command="{Binding PickWorkbenchSystemFontCommand}" CommandParameter="editor"
                                            Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,4,0"
                                            ToolTip="系统字体" />
                                    <Button Grid.Column="2" Content="浏览…" VerticalAlignment="Center"
                                            Command="{Binding PickWorkbenchFontFromFileCommand}" CommandParameter="editor"
                                            Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,10,0"
                                            ToolTip="字体文件（ttf/otf/ttc）" />
                                </Grid>
                            </StackPanel>

                            <Expander Header="对齐与微调" IsExpanded="False" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="磁吸步长" Style="{StaticResource FormLabel}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding WorkbenchSnapStepChoices}"
                                              SelectedItem="{Binding WorkbenchLayoutSnapStepPixels, Mode=TwoWay}"
                                              Margin="0,0,0,8"
                                              ToolTip="拖动与对齐网格共用" />
                                    <WrapPanel Margin="0,0,0,6">
                                        <Button Content="对齐网格" Command="{Binding SnapWorkbenchPositionToGridCommand}" Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,6,4"
                                                ToolTip="对齐到磁吸网格" />
                                        <Button Content="坐标取整" Command="{Binding RoundWorkbenchPositionToIntegerCommand}" Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,0,4"
                                                ToolTip="坐标取整为像素" />
                                    </WrapPanel>
                                    <TextBlock Text="平移" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                                    <UniformGrid Rows="2" Columns="4" HorizontalAlignment="Stretch">
                                        <Button Content="←" ToolTip="左 · 步长" Command="{Binding NudgeWorkbenchPositionByStepCommand}" CommandParameter="L" Style="{StaticResource StandardButtonStyle}" Padding="6,4" Margin="2" />
                                        <Button Content="→" ToolTip="右 · 步长" Command="{Binding NudgeWorkbenchPositionByStepCommand}" CommandParameter="R" Style="{StaticResource StandardButtonStyle}" Padding="6,4" Margin="2" />
                                        <Button Content="↑" ToolTip="上 · 步长" Command="{Binding NudgeWorkbenchPositionByStepCommand}" CommandParameter="U" Style="{StaticResource StandardButtonStyle}" Padding="6,4" Margin="2" />
                                        <Button Content="↓" ToolTip="下 · 步长" Command="{Binding NudgeWorkbenchPositionByStepCommand}" CommandParameter="D" Style="{StaticResource StandardButtonStyle}" Padding="6,4" Margin="2" />
                                        <Button Content="←1" ToolTip="左 · 1 px" Command="{Binding NudgeWorkbenchPositionOnePixelCommand}" CommandParameter="L" Style="{StaticResource StandardButtonStyle}" Padding="6,4" Margin="2" />
                                        <Button Content="→1" ToolTip="右 · 1 px" Command="{Binding NudgeWorkbenchPositionOnePixelCommand}" CommandParameter="R" Style="{StaticResource StandardButtonStyle}" Padding="6,4" Margin="2" />
                                        <Button Content="↑1" ToolTip="上 · 1 px" Command="{Binding NudgeWorkbenchPositionOnePixelCommand}" CommandParameter="U" Style="{StaticResource StandardButtonStyle}" Padding="6,4" Margin="2" />
                                        <Button Content="↓1" ToolTip="下 · 1 px" Command="{Binding NudgeWorkbenchPositionOnePixelCommand}" CommandParameter="D" Style="{StaticResource StandardButtonStyle}" Padding="6,4" Margin="2" />
                                    </UniformGrid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="默认字体" IsExpanded="False" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"
                                      ToolTip="未指定元素字体时的回退字体">
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Style="{StaticResource WorkbenchFontComboStyle}"
                                              ItemsSource="{Binding LayoutDefaultFontPickerItems}"
                                              SelectedValue="{Binding LayoutDefaultFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="版式默认字体" />
                                    <Button Grid.Column="1" Content="系统…" VerticalAlignment="Center"
                                            Command="{Binding PickWorkbenchSystemFontCommand}" CommandParameter="default"
                                            Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,4,0"
                                            ToolTip="系统字体" />
                                    <Button Grid.Column="2" Content="浏览…" VerticalAlignment="Center"
                                            Command="{Binding PickWorkbenchFontFromFileCommand}" CommandParameter="default"
                                            Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,10,0"
                                            ToolTip="字体文件（ttf/otf/ttc）" />
                                </Grid>
                            </Expander>

                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="导出…" Command="{Binding SaveLayoutJsonCommand}" Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,6,4"
                                        ToolTip="导出版式" />
                                <Button Content="保存为默认" Command="{Binding SaveLayoutJsonToDefaultPathCommand}" Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,6,4"
                                        ToolTip="保存至 Config\ticket-face-layout.json" />
                                <Button Content="导入…" Command="{Binding LoadLayoutJsonCommand}" Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,6,4"
                                        ToolTip="导入版式" />
                                <Button Content="恢复默认" Command="{Binding ResetLayoutToFactoryDefaultsCommand}" Style="{StaticResource StandardButtonStyle}" Padding="8,4" Margin="0,0,0,4"
                                        ToolTip="恢复出厂版式" />
                            </WrapPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource SmallFontSize}"
                                       Text="Config\ticket-face-layout.json" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 行程对照：预览模式占满侧栏；版式编辑默认折叠 -->
                    <Expander Grid.Row="1"
                              IsExpanded="{Binding IsLayoutWorkbench, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"
                              ExpandDirection="Down" Margin="0,0,0,0"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <!-- 预览：去掉折叠头，直接展示行程信息 -->
                                    <DataTrigger Binding="{Binding IsLayoutWorkbench}" Value="False">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Expander">
                                                    <ContentPresenter ContentSource="Content" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding TripDataSectionTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TripDataSectionHint}" FontSize="{DynamicResource SmallFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" Margin="0,6,0,0">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLayoutWorkbench}" Value="True">
                                            <Setter Property="MaxHeight" Value="320" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                    <TextBlock Text="请先在行程列表中选择一条记录。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,12,0,12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding HasSelectedDraft, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <DockPanel Visibility="{Binding HasSelectedDraft, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                                    Visibility="{Binding HasMultipleDrafts, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="切换行程" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PreviewDrafts}" SelectedItem="{Binding SelectedDraft}" DisplayMemberPath="DisplayTitle" />
                        </StackPanel>
                        <StackPanel DataContext="{Binding SelectedDraft}">
                                <TextBlock Text="{Binding DataContext.TripDataSectionTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                           FontSize="{DynamicResource LargeFontSize}"
                                           Visibility="{Binding DataContext.IsLayoutWorkbench, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="车票号码" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.TicketNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="检票口" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="3" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.CheckInLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="出发站" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.DepartStation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="到达站" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="3" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.ArriveStation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="出发拼音" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.DepartStationPinyin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="到达拼音" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="3" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.ArriveStationPinyin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="出发日期" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.DepartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="车次" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="3" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.TrainNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="出发时间" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.DepartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="车厢" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="3" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.CoachNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="座位号" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.SeatNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="票价" Style="{StaticResource FormLabel}" />
                                    <TextBox Grid.Column="3" Style="{StaticResource FormBox}"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding Source.Money, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="附加信息" Style="{StaticResource FormLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource FormCombo}"
                                              IsEnabled="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                              ItemsSource="{Binding DataContext.PreviewAdditionalInfoOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Source.AdditionalInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="座位类型" Style="{StaticResource FormLabel}" />
                                    <ComboBox Grid.Column="3" Style="{StaticResource FormCombo}"
                                              IsEnabled="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                              ItemsSource="{Binding DataContext.PreviewSeatTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Source.SeatType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="改签类型" Style="{StaticResource FormLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource FormCombo}"
                                              IsEnabled="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                              ItemsSource="{Binding DataContext.PreviewTicketModificationTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Source.TicketModificationType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="车票用途" Style="{StaticResource FormLabel}" />
                                    <ComboBox Grid.Column="3" Style="{StaticResource FormCombo}"
                                              IsEnabled="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                              ItemsSource="{Binding DataContext.PreviewTicketPurposeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Source.TicketPurpose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="票种标志" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <WrapPanel Orientation="Horizontal">
                                            <CheckBox Content="学生票" Margin="0,0,16,6"
                                                      IsEnabled="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                      IsChecked="{Binding DataContext.PreviewTicketFlagStudent, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                                            <CheckBox Content="儿童票" Margin="0,0,16,6"
                                                      IsEnabled="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                      IsChecked="{Binding DataContext.PreviewTicketFlagChild, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                                            <CheckBox Content="优惠票" Margin="0,0,16,6"
                                                      IsEnabled="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                      IsChecked="{Binding DataContext.PreviewTicketFlagDiscount, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                                            <CheckBox Content="网络售票" Margin="0,0,0,6"
                                                      IsEnabled="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                      IsChecked="{Binding DataContext.PreviewTicketFlagOnline, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                                        </WrapPanel>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource SmallFontSize}" Margin="0,0,0,0"
                                                   Text="学生票与儿童票互斥；优惠票、网络售票可同时勾选。" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="支付渠道" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="在线支付" Style="{StaticResource FormLabel}" Margin="0,0,0,2" />
                                        <ComboBox Style="{StaticResource FormCombo}"
                                                  IsEnabled="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                  ItemsSource="{Binding DataContext.PreviewPaymentOnlineOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.PreviewPaymentOnlineSelection, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="银行" Style="{StaticResource FormLabel}" Margin="0,6,0,2" />
                                        <ComboBox Style="{StaticResource FormCombo}"
                                                  IsEnabled="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                  ItemsSource="{Binding DataContext.PreviewPaymentBankOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.PreviewPaymentBankSelection, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource SmallFontSize}" Margin="0,4,0,4"
                                                   Text="决定票面支付简字（支 / 微 / 银）。" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="票底提示" Style="{StaticResource FormLabel}" Margin="0,4,0,2" />
                                <TextBox Style="{StaticResource FormBox}"
                                         IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Text="{Binding Source.Hint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" />

                                <TextBlock Text="显示选项" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource SmallFontSize}" Margin="0,0,0,6"
                                           Text="{Binding DataContext.TripDataSectionHint, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <CheckBox Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}"
                                          Content="优惠简字显示为「折」"
                                          ToolTip="勾选后票面用「折」，否则用「惠」。仅影响本窗口。"
                                          IsChecked="{Binding PreferDiscountZhe, Mode=TwoWay}" />

                                <TextBlock Text="{Binding DataContext.IdentitySectionTitle, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="身份证号" Style="{StaticResource FormLabel}" />
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IdentityInputError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBox Style="{StaticResource FormBox}" BorderThickness="0" Margin="0"
                                             IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Text="{Binding IdNumber, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>
                                <TextBlock Text="姓名" Style="{StaticResource FormLabel}" Margin="0,6,0,0" />
                                <TextBox Style="{StaticResource FormBox}"
                                         IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Text="{Binding PassengerName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="掩码" Style="{StaticResource FormLabel}" Margin="0,6,0,0" />
                                <TextBox Style="{StaticResource FormBox}"
                                         IsReadOnly="{Binding DataContext.IsTripFieldsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Text="{Binding IdMask, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="编码区" FontWeight="SemiBold" Margin="0,12,0,2" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="二维码内容" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource FormBox}" Text="{Binding DataContext.EncodingText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </Grid>
            </Border>

            <!-- 右侧：811×509 票面；缩放仅 LayoutTransform（不用 Viewbox，否则与 Scale 叠加后百分比不起作用） -->
            <ScrollViewer x:Name="TicketPreviewScrollHost" Grid.Column="1" Margin="8"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          PreviewMouseWheel="TicketPreviewScrollHost_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="TicketPreviewScrollHost_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="TicketPreviewScrollHost_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="TicketPreviewScrollHost_PreviewMouseLeftButtonUp"
                          LostMouseCapture="TicketPreviewScrollHost_LostMouseCapture"
                          Loaded="TicketPreviewScrollHost_Loaded"
                          SizeChanged="TicketPreviewScrollHost_SizeChanged">
                <Grid Width="811" Height="509">
                    <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ScaleX}" ScaleY="{Binding ScaleY}" />
                    </Grid.LayoutTransform>
                    <Canvas x:Name="TicketPreviewSurface" Width="811" Height="509" ClipToBounds="True"
                            DataContext="{Binding SelectedDraft}">
                                    <Rectangle Width="811" Height="509" Fill="{DynamicResource TicketVoucherBlueSurfaceBrush}" />
                                    <Image Width="811" Height="509" Stretch="Fill"
                                           Source="{Binding DataContext.TicketBackgroundImage, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Opacity="{Binding DataContext.TicketBackgroundOpacity, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <Trigger Property="Source" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                        </Image>

                                    <!-- 票号 -->
                                    <TextBlock hit:LayoutWorkbenchHit.Kind="TicketSerial" Foreground="{DynamicResource TicketVoucherSerialTextBrush}" FontWeight="Bold"
                                               FontSize="{Binding DataContext.ActiveLayout.TicketSerialFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Text="{Binding Source.TicketNumber, Mode=OneWay}"
                                               Canvas.Left="{Binding DataContext.ActiveLayout.TicketSerialLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Top="{Binding DataContext.ActiveLayout.TicketSerialTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="TicketSerial">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.TicketSerialFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.FontFamily>
                                    </TextBlock>
                                    <!-- 检票：标签与内容独立锚点 -->
                                    <TextBlock hit:LayoutWorkbenchHit.Kind="CheckInLabel" Text="检票：" Foreground="{DynamicResource TicketVoucherPrimaryTextBrush}"
                                               FontSize="{Binding DataContext.ActiveLayout.CheckInFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Left="{Binding DataContext.ActiveLayout.CheckInLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Top="{Binding DataContext.ActiveLayout.CheckInTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="CheckInLabel">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.CheckInFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.FontFamily>
                                    </TextBlock>
                                    <TextBlock hit:LayoutWorkbenchHit.Kind="CheckInValue" Foreground="{DynamicResource TicketVoucherPrimaryTextBrush}"
                                               Text="{Binding Source.CheckInLocation, Mode=OneWay}"
                                               FontSize="{Binding DataContext.ActiveLayout.CheckInValueFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Left="{Binding DataContext.ActiveLayout.CheckInValueLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Top="{Binding DataContext.ActiveLayout.CheckInValueTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="CheckInValue">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.CheckInValueFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.ActiveLayout.CheckInFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.FontFamily>
                                    </TextBlock>

                                    <!-- 发站（字距）：站名主体 + 「站」字同一行，站字用 Margin 相对主体定位 -->
                                    <StackPanel hit:LayoutWorkbenchHit.Kind="DepartStation" Orientation="Horizontal" Canvas.Left="{Binding DataContext.PreviewDepartStationCanvasLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Canvas.Top="{Binding DataContext.ActiveLayout.DepartStationTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="DepartStation">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource TicketVoucherPrimaryTextBrush}"
                                                   FontSize="{Binding DataContext.ActiveLayout.DepartStationNameFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Text="{Binding DataContext.PreviewDepartStationText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}">
                                            <TextBlock.FontFamily>
                                                <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                    <Binding Path="DataContext.ActiveLayout.DepartStationNameFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </TextBlock.FontFamily>
                                        </TextBlock>
                                        <TextBlock hit:LayoutWorkbenchHit.Kind="DepartStationZhan" Text="站" FontWeight="Bold" Foreground="{DynamicResource TicketVoucherPrimaryTextBrush}"
                                                   Margin="{Binding DataContext.PreviewDepartStationZhanMargin, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="{Binding DataContext.ActiveLayout.DepartStationZhanFont, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="DepartStationZhan">
                                                    <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="DepartStationShowZhan" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                            <TextBlock.FontFamily>
                                                <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                    <Binding Path="DataContext.ActiveLayout.DepartStationZhanFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="DataContext.ActiveLayout.DepartStationNameFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </TextBlock.FontFamily>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock hit:LayoutWorkbenchHit.Kind="DepartPinyin" Foreground="{DynamicResource TicketVoucherSecondaryTextBrush}"
                                               FontSize="{Binding DataContext.ActiveLayout.PinyinFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Text="{Binding Source.DepartStationPinyin, Mode=OneWay}"
                                               Canvas.Left="{Binding DataContext.ActiveLayout.DepartPinyinLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Top="{Binding DataContext.ActiveLayout.DepartPinyinTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="DepartPinyin">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.PinyinFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.FontFamily>
                                    </TextBlock>

                                    <TextBlock hit:LayoutWorkbenchHit.Kind="TrainNo" Text="{Binding Source.TrainNo, Mode=OneWay}" FontWeight="Bold"
                                               Foreground="{DynamicResource TicketVoucherPrimaryTextBrush}"
                                               FontSize="{Binding DataContext.ActiveLayout.TrainNoFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Left="{Binding DataContext.ActiveLayout.TrainNoLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Top="{Binding DataContext.ActiveLayout.TrainNoTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="TrainNo">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.TrainNoFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.FontFamily>
                                    </TextBlock>
                                    <controls:TicketFaceArrowControl hit:LayoutWorkbenchHit.Kind="Arrow" Canvas.Left="{Binding DataContext.ArrowCanvasLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Canvas.Top="{Binding DataContext.ActiveLayout.ArrowTop, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Margin="0,2,0,0"
                                                                     Length="{Binding DataContext.ActiveLayout.ArrowLength, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     StrokeThickness="{Binding DataContext.ActiveLayout.ArrowStrokeThickness, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     HeadLength="{Binding DataContext.ActiveLayout.ArrowHeadLength, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     HeadWidth="{Binding DataContext.ActiveLayout.ArrowHeadWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     ArrowStroke="{DynamicResource TicketVoucherPrimaryTextBrush}">
                                        <controls:TicketFaceArrowControl.Visibility>
