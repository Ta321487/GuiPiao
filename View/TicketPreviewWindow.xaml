                                               Canvas.Top="{Binding DataContext.ActiveLayout.SeatTypeTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="SeatType">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.SeatTypeFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.FontFamily>
                                    </TextBlock>

                                    <TextBlock hit:LayoutWorkbenchHit.Kind="TicketModificationType"
                                               Foreground="{DynamicResource TicketVoucherMutedTextBrush}"
                                               FontSize="{Binding DataContext.ActiveLayout.TicketModificationTypeFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                               TextWrapping="Wrap" MaxWidth="{Binding DataContext.ActiveLayout.HintBoxWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Text="{Binding Source.TicketModificationType, Mode=OneWay}"
                                               Canvas.Left="{Binding DataContext.ActiveLayout.TicketModificationTypeLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Top="{Binding DataContext.ActiveLayout.TicketModificationTypeTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="TicketModificationType">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.TicketModificationTypeFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.FontFamily>
                                    </TextBlock>

                                    <TextBlock hit:LayoutWorkbenchHit.Kind="Purpose" Foreground="{DynamicResource TicketVoucherMutedTextBrush}" FontSize="{Binding DataContext.ActiveLayout.PurposeFont, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" MaxWidth="{Binding DataContext.ActiveLayout.HintBoxWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Text="{Binding Source.TicketPurpose, Mode=OneWay}"
                                               Canvas.Left="{Binding DataContext.ActiveLayout.PurposeLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Top="{Binding DataContext.ActiveLayout.PurposeTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="Purpose">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.PurposeFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.FontFamily>
                                    </TextBlock>

                                    <TextBlock hit:LayoutWorkbenchHit.Kind="AdditionalInfo" Foreground="{DynamicResource TicketVoucherMutedTextBrush}" TextWrapping="Wrap" MaxWidth="720"
                                               Text="{Binding Source.AdditionalInfo, Mode=OneWay}"
                                               FontSize="{Binding DataContext.ActiveLayout.AdditionalInfoFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Left="{Binding DataContext.ActiveLayout.AdditionalInfoLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Top="{Binding DataContext.ActiveLayout.AdditionalInfoTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="AdditionalInfo">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="HasAdditionalInfo" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.AdditionalInfoFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.FontFamily>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Canvas.Left="{Binding DataContext.ActiveLayout.IdNameLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Canvas.Top="{Binding DataContext.ActiveLayout.IdNameTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="IdName">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                        <TextElement.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.IdNameFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextElement.FontFamily>
                                        <TextBlock Foreground="{DynamicResource TicketVoucherMutedTextBrush}" FontSize="{Binding DataContext.ActiveLayout.IdNameFont, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding IdMask, Mode=OneWay}" />
                                        <TextBlock Width="8" />
                                        <TextBlock Foreground="{DynamicResource TicketVoucherMutedTextBrush}" FontSize="{Binding DataContext.ActiveLayout.IdNameFont, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding PassengerName, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- 提示区：虚线框随文字收缩，右边线贴最长行；HintBoxWidth 为折行上限 -->
                                    <Grid hit:LayoutWorkbenchHit.Kind="HintBox"
                                          HorizontalAlignment="Left"
                                          Canvas.Left="{Binding DataContext.ActiveLayout.HintBoxLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Canvas.Top="{Binding DataContext.ActiveLayout.HintBoxTop, RelativeSource={RelativeSource AncestorType=Window}}"
                                          MaxWidth="{Binding DataContext.ActiveLayout.HintBoxWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Grid.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="HintBox">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Grid.Visibility>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 细虚线外框：与实体报销凭证/客票「广告栏」一致 -->
                                        <Rectangle Grid.Column="0"
                                                   Stroke="{DynamicResource TicketVoucherDisclaimerBorderBrush}"
                                                   StrokeThickness="1"
                                                   StrokeDashArray="2.2 1.6"
                                                   Fill="Transparent"
                                                   SnapsToDevicePixels="True"
                                                   UseLayoutRounding="True" />
                                        <ItemsControl Grid.Column="0"
                                                      ItemsSource="{Binding HintLines}"
                                                      Margin="8,5,8,5"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TicketVoucherSubtleTextBrush}"
                                                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch"
                                                               Margin="0,0,0,1"
                                                               FontSize="{Binding DataContext.ActiveLayout.HintFont, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <TextBlock.FontFamily>
                                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                                <Binding Path="DataContext.ActiveLayout.HintFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </TextBlock.FontFamily>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <TextBlock Foreground="{DynamicResource TicketVoucherFooterForegroundBrush}" FontSize="{Binding DataContext.ActiveLayout.FooterFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Text="{Binding FooterReceiptLine, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="720"
                                               Canvas.Left="{Binding DataContext.ActiveLayout.FooterLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Canvas.Top="{Binding DataContext.ActiveLayout.FooterTop, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="Footer">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.FontFamily>
                                            <MultiBinding Converter="{StaticResource LayoutFontFamilyMultiConverter}">
                                                <Binding Path="DataContext.ActiveLayout.FooterFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutDefaultFontFamily" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.FontFamily>
                                    </TextBlock>

                                    <Image hit:LayoutWorkbenchHit.Kind="Qr" Source="{Binding DataContext.QrCodeSource, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Width="{Binding DataContext.ActiveLayout.QrSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Height="{Binding DataContext.ActiveLayout.QrSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Canvas.Left="{Binding DataContext.ActiveLayout.QrLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Canvas.Top="{Binding DataContext.ActiveLayout.QrTop, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Stretch="Uniform">
                                        <Image.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="Qr">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Image.Visibility>
                                    </Image>

                                    <!-- 票种简字：共用 TicketBadgeGlyphVisual，各自锚点 -->
                                    <ContentControl hit:LayoutWorkbenchHit.Kind="BadgeLetterXue"
                                                    Canvas.Left="{Binding DataContext.ActiveLayout.BadgeLetterXueLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Canvas.Top="{Binding DataContext.ActiveLayout.BadgeLetterXueTop, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Content="学" ContentTemplate="{StaticResource TicketBadgeGlyphVisual}">
                                        <ContentControl.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="BadgeLetterXue">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.ShowTicketBadgeXue" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </ContentControl.Visibility>
                                    </ContentControl>
                                    <ContentControl hit:LayoutWorkbenchHit.Kind="BadgeLetterHai"
                                                    Canvas.Left="{Binding DataContext.ActiveLayout.BadgeLetterHaiLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Canvas.Top="{Binding DataContext.ActiveLayout.BadgeLetterHaiTop, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Content="孩" ContentTemplate="{StaticResource TicketBadgeGlyphVisual}">
                                        <ContentControl.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="BadgeLetterHai">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.ShowTicketBadgeHai" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </ContentControl.Visibility>
                                    </ContentControl>
                                    <ContentControl hit:LayoutWorkbenchHit.Kind="BadgeLetterWang"
                                                    Canvas.Left="{Binding DataContext.ActiveLayout.BadgeLetterWangLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Canvas.Top="{Binding DataContext.ActiveLayout.BadgeLetterWangTop, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Content="网" ContentTemplate="{StaticResource TicketBadgeGlyphVisual}">
                                        <ContentControl.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="BadgeLetterWang">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.ShowTicketBadgeWang" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </ContentControl.Visibility>
                                    </ContentControl>
                                    <ContentControl hit:LayoutWorkbenchHit.Kind="BadgeLetterDiscount"
                                                    Canvas.Left="{Binding DataContext.ActiveLayout.BadgeLetterDiscountLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Canvas.Top="{Binding DataContext.ActiveLayout.BadgeLetterDiscountTop, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Content="{Binding DataContext.TicketDiscountBadgeChar, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ContentTemplate="{StaticResource TicketBadgeGlyphVisual}">
                                        <ContentControl.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="BadgeLetterDiscount">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.ShowTicketBadgeDiscount" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </ContentControl.Visibility>
                                    </ContentControl>
                                    <ItemsControl hit:LayoutWorkbenchHit.Kind="BadgePaymentRow" Canvas.Left="{Binding DataContext.ActiveLayout.BadgePaymentRowLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Canvas.Top="{Binding DataContext.ActiveLayout.BadgePaymentRowTop, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ItemsSource="{Binding DataContext.PaymentBadgeLetters, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.Visibility>
                                            <MultiBinding Converter="{StaticResource TicketLayoutIsolationToVisibilityConverter}" ConverterParameter="BadgePaymentRow">
                                                <Binding Path="DataContext.SessionMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.LayoutIsolationTargetKind" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="DataContext.HasPaymentBadgeLetters" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </ItemsControl.Visibility>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TicketBadgeGlyphVisual}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 拖拽微调时：8px 对齐网格（在透明拖拽层之下，不拦截鼠标） -->
                                    <Border Canvas.Left="0" Canvas.Top="0" Width="811" Height="509" Panel.ZIndex="998" IsHitTestVisible="False" Opacity="0.28"
                                            DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"
                                            Visibility="{Binding IsVisualLayoutEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Background>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Stretch="None">
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing Brush="Transparent">
                                                        <GeometryDrawing.Pen>
                                                            <Pen Brush="{DynamicResource BorderBrush}" Thickness="1" />
                                                        </GeometryDrawing.Pen>
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,8,8" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Border.Background>
                                    </Border>

                                    <Rectangle x:Name="LayoutEditOverlay" Canvas.Left="0" Canvas.Top="0" Width="811" Height="509" Fill="Transparent"
                                               Panel.ZIndex="999" Cursor="SizeAll"
                                               DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"
                                               Visibility="{Binding IsVisualLayoutEdit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               PreviewMouseLeftButtonDown="LayoutEditOverlay_OnPreviewMouseDown"
                                               PreviewMouseMove="LayoutEditOverlay_OnPreviewMouseMove"
                                               PreviewMouseLeftButtonUp="LayoutEditOverlay_OnPreviewMouseUp" />

                                    <Border Panel.ZIndex="1000" Background="{Binding DataContext.BrightnessOverlayBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Width="811" Height="509" IsHitTestVisible="False" />
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 底部操作 -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="导出 PNG" Style="{StaticResource StandardButtonStyle}" Padding="12,6" Margin="0,0,10,0"
                            Command="{Binding ExportPngCommand}" CommandParameter="{Binding ElementName=TicketPreviewSurface}"
                            ToolTip="导出 811×509 像素 PNG" />
                    <Button Content="蓝色" Style="{StaticResource StandardButtonStyle}" Margin="0,0,6,0" Padding="10,6"
                            Command="{Binding SwitchRedBlueCommand}" CommandParameter="blue"
                            ToolTip="蓝色票样" />
                    <Button Content="红色" Style="{StaticResource StandardButtonStyle}" Margin="0,0,12,0" Padding="10,6"
                            Command="{Binding SwitchRedBlueCommand}" CommandParameter="red"
                            ToolTip="红色票样" />
                    <Button Content="关闭" Style="{StaticResource StandardButtonStyle}" Padding="12,6"
                            Command="{Binding CloseWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding TicketInfo, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ZoomPercentText, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
