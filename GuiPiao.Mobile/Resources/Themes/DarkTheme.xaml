<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="GuiPiao.Mobile.Resources.Themes.DarkTheme">

    <!-- 结构色：与 PC Themes/DarkTheme.xaml 同名同值 -->
    <Color x:Key="WindowBackground">#2D2D30</Color>
    <Color x:Key="ContentBackground">#252526</Color>
    <Color x:Key="PanelBackground">#3E3E42</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#E0E0E0</Color>
    <Color x:Key="TextDisabled">#808080</Color>
    <Color x:Key="Border">#555555</Color>
    <Color x:Key="Divider">#4A4A4A</Color>
    <Color x:Key="ControlBackground">#3C3C3C</Color>
    <Color x:Key="ControlHover">#4A4A4A</Color>
    <Color x:Key="ControlPressed">#505050</Color>
    <Color x:Key="ImportFieldHighlight">#5C4A1F</Color>
    <Color x:Key="Success">#4CAF50</Color>
    <Color x:Key="Warning">#FF9800</Color>
    <Color x:Key="Error">#F44336</Color>
    <Color x:Key="Info">#2196F3</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackground}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackground}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackground}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackground}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHover}" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressed}" />
    <SolidColorBrush x:Key="ImportFieldHighlightBrush" Color="{StaticResource ImportFieldHighlight}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}" />

    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentForeground">#60CDFF</Color>
    <Color x:Key="AccentHover">#106EBE</Color>
    <Color x:Key="AccentPressed">#005A9E</Color>
    <Color x:Key="AccentText">#FFFFFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#106EBE" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />

    <!-- 报销凭证票面：与浅色同一套（避免深色主题黑底黑字） -->
    <Color x:Key="TicketVoucherSerialText">#C62828</Color>
    <Color x:Key="TicketVoucherPrimaryText">#000000</Color>
    <Color x:Key="TicketVoucherSecondaryText">#000000</Color>
    <Color x:Key="TicketVoucherMutedText">#000000</Color>
    <Color x:Key="TicketVoucherSubtleText">#000000</Color>
    <Color x:Key="TicketVoucherCardBorder">#7FA8C4</Color>
    <Color x:Key="TicketVoucherDisclaimerBorder">#000000</Color>
    <Color x:Key="TicketVoucherFooterForeground">#000000</Color>
    <Color x:Key="TicketVoucherQrPlaceholderBackground">#ECEFF1</Color>
    <Color x:Key="TicketVoucherQrPlaceholderBorder">#90A4AE</Color>
    <Color x:Key="TicketVoucherQrPlaceholderForeground">#000000</Color>
    <Color x:Key="TicketVoucherBlueSurfaceStart">#D4EBF5</Color>
    <Color x:Key="TicketVoucherBlueSurfaceEnd">#E8F6FC</Color>

    <LinearGradientBrush x:Key="TicketVoucherBlueSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource TicketVoucherBlueSurfaceStart}" Offset="0" />
        <GradientStop Color="{StaticResource TicketVoucherBlueSurfaceEnd}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TicketVoucherSerialTextBrush" Color="{StaticResource TicketVoucherSerialText}" />
    <SolidColorBrush x:Key="TicketVoucherPrimaryTextBrush" Color="{StaticResource TicketVoucherPrimaryText}" />
    <SolidColorBrush x:Key="TicketVoucherCardBorderBrush" Color="{StaticResource TicketVoucherCardBorder}" />
    <SolidColorBrush x:Key="TicketVoucherDisclaimerBorderBrush" Color="{StaticResource TicketVoucherDisclaimerBorder}" />
    <SolidColorBrush x:Key="TicketVoucherFooterForegroundBrush" Color="{StaticResource TicketVoucherFooterForeground}" />
    <SolidColorBrush x:Key="TicketVoucherQrPlaceholderBackgroundBrush" Color="{StaticResource TicketVoucherQrPlaceholderBackground}" />
    <SolidColorBrush x:Key="TicketVoucherQrPlaceholderBorderBrush" Color="{StaticResource TicketVoucherQrPlaceholderBorder}" />
</ResourceDictionary>
