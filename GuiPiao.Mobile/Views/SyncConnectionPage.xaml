<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GuiPiao.Mobile.ViewModels"
             x:Class="GuiPiao.Mobile.Views.SyncConnectionPage"
             x:DataType="vm:SyncViewModel"
             Title="连接与配对"
             BackgroundColor="{DynamicResource WindowBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label Text="连接与配对"
                   FontSize="{DynamicResource TitleFontSize}"
                   FontAttributes="Bold" />

            <Label Text="服务地址" FontAttributes="Bold" />
            <Entry Text="{Binding BaseUrl}"
                   Keyboard="Url"
                   Placeholder="http://192.168.x.x:17880" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="重新扫码"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding OpenScanCommand}"
                        HeightRequest="44" />
                <Button Grid.Column="1"
                        Text="粘贴"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding PasteServerUrlCommand}"
                        HeightRequest="44" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="检测连接"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CheckHealthCommand}"
                        HeightRequest="44" />
                <Button Grid.Column="1"
                        Text="保存"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding SaveServerCommand}"
                        HeightRequest="44" />
            </Grid>

            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0,4" />

            <Label Text="设备名称" FontAttributes="Bold" />
            <Entry Text="{Binding DeviceName}" Placeholder="GuiPiao Mobile" />
            <Button Text="保存名称"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SaveServerCommand}"
                    HeightRequest="44" />

            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0,4" />

            <Label Text="{Binding StatusText}" TextColor="{DynamicResource AccentForeground}" />
            <Label Text="{Binding DetailText}"
                   FontSize="{DynamicResource SmallFontSize}"
                   TextColor="{DynamicResource TextSecondary}" />

            <Button Text="解除配对"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding UnpairCommand}"
                    IsVisible="{Binding IsPaired}"
                    Margin="0,8,0,0"
                    HeightRequest="44" />

            <Button Text="从相册识别（备用）"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ScanQrFromPhotoCommand}"
                    HeightRequest="40"
                    Opacity="0.85" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
