<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sync="clr-namespace:GuiPiao.Model.Sync"
             xmlns:vm="clr-namespace:GuiPiao.Mobile.ViewModels"
             x:Class="GuiPiao.Mobile.Views.SyncPage"
             x:DataType="vm:SyncViewModel"
             x:Name="SyncRoot"
             Title="同步"
             BackgroundColor="{DynamicResource WindowBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="GuiPiao"
                   FontSize="{DynamicResource TitleFontSize}"
                   FontAttributes="Bold" />
            <Label Text="在 PC 设置 → 同步点击「开始配对」，确认下方「服务地址」后输入配对码完成绑定，再执行「立即对齐」。"
                   TextColor="{DynamicResource TextSecondary}"
                   FontSize="{DynamicResource SmallFontSize}" />

            <Border Style="{StaticResource PanelBorderStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="服务地址" FontAttributes="Bold" />
                    <Entry Text="{Binding BaseUrl}"
                           Keyboard="Url"
                           Placeholder="与 PC「服务地址」一致，如 http://192.168.x.x:17880" />
                    <Entry Text="{Binding DeviceName}" Placeholder="设备名称" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="保存地址"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SaveServerCommand}"
                                HeightRequest="44" />
                        <Button Grid.Column="1"
                                Text="检测连接"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CheckHealthCommand}"
                                HeightRequest="44" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="剪贴板填地址"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PasteServerUrlCommand}"
                                HeightRequest="44" />
                        <Button Grid.Column="1"
                                Text="扫码选图"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ScanQrFromPhotoCommand}"
                                HeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="配对码" FontAttributes="Bold" />
                    <Entry Text="{Binding PairingCode}"
                           Placeholder="6 位配对码"
                           Keyboard="Numeric"
                           MaxLength="6"
                           FontFamily="Consolas"
                           FontSize="24" />
                    <Button Text="配对"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding PairCommand}" />
                    <Button Text="撤销配对"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding UnpairCommand}"
                            IsVisible="{Binding IsPaired}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="立即对齐"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AlignCommand}"
                    IsEnabled="{Binding IsPaired}" />

            <Button Text="同步车站库"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SyncStationsCommand}"
                    IsEnabled="{Binding IsPaired}" />
            <Label Text="{Binding StationsHint}"
                   FontSize="{DynamicResource SmallFontSize}"
                   TextColor="{DynamicResource TextSecondary}" />

            <Border Style="{StaticResource PanelBorderStyle}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="冲突箱" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="刷新"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,6"
                                Command="{Binding RefreshConflictsCommand}"
                                IsEnabled="{Binding IsPaired}" />
                    </Grid>
                    <Label Text="无待处理冲突"
                           IsVisible="{Binding HasConflicts, Converter={StaticResource InvertedBoolConverter}}"
                           FontSize="{DynamicResource SmallFontSize}"
                           TextColor="{DynamicResource TextSecondary}" />
                    <CollectionView ItemsSource="{Binding Conflicts}"
                                    IsVisible="{Binding HasConflicts}"
                                    HeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="sync:SyncConflictDto">
                                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,8" Padding="10">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Entity, StringFormat='实体：{0}'}" FontAttributes="Bold" />
                                        <Label Text="{Binding SyncId, StringFormat='sync_id：{0}'}"
                                               FontSize="{DynamicResource SmallFontSize}"
                                               TextColor="{DynamicResource TextSecondary}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Text="保留电脑"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding Source={x:Reference SyncRoot}, Path=BindingContext.ResolveKeepLocalCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="1"
                                                    Text="采用手机"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding Source={x:Reference SyncRoot}, Path=BindingContext.ResolveKeepRemoteCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding StatusText}" TextColor="{DynamicResource AccentForeground}" />
                    <Label Text="{Binding DetailText}"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="{DynamicResource SmallFontSize}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource AccentColor}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
