<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:GuiPiao.Mobile.Icons"
             xmlns:vm="clr-namespace:GuiPiao.Mobile.ViewModels"
             x:Class="GuiPiao.Mobile.Views.SyncPage"
             x:DataType="vm:SyncViewModel"
             Title="同步"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WindowBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12">

        <!-- 顶栏：连接状态（页标题由 Shell 导航栏提供，避免双标题） -->
        <Border HorizontalOptions="End"
                Padding="10,4"
                StrokeThickness="1"
                Stroke="{DynamicResource Border}"
                BackgroundColor="{DynamicResource PanelBackground}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="6">
                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                         Color="{DynamicResource AccentColor}"
                         IsVisible="{Binding IsPaired}" />
                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                         Color="{DynamicResource TextSecondary}"
                         IsVisible="{Binding IsPaired, Converter={StaticResource InvertedBoolConverter}}" />
                <Label Text="{Binding StatusText}"
                       FontSize="{DynamicResource SmallFontSize}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- 中心：球形仓 -->
        <Grid Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center">
            <!-- 未配对：虚线环 + 配对码 -->
            <Border x:Name="UnpairedRing"
                    WidthRequest="240" HeightRequest="240"
                    Stroke="{DynamicResource AccentForegroundBrush}"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    IsVisible="{Binding IsPaired, Converter={StaticResource InvertedBoolConverter}}"
                    SemanticProperties.Description="配对码输入">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="120" />
                </Border.StrokeShape>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4" Padding="24">
                    <Entry Text="{Binding PairingCode}"
                           Placeholder="······"
                           Keyboard="Numeric"
                           MaxLength="6"
                           FontFamily="Consolas"
                           FontSize="36"
                           HorizontalTextAlignment="Center"
                           BackgroundColor="Transparent"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- 已配对：实心球 -->
            <Border x:Name="PairedSphere"
                    WidthRequest="220" HeightRequest="220"
                    StrokeThickness="0"
                    BackgroundColor="{DynamicResource AccentColor}"
                    IsVisible="{Binding IsPaired}"
                    SemanticProperties.Description="对齐">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="110" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AlignCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                    <Label Text="{Binding SpherePrimary}"
                           TextColor="{DynamicResource AccentText}"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding SphereSecondary}"
                           TextColor="{DynamicResource AccentText}"
                           FontSize="{DynamicResource BaseFontSize}"
                           HorizontalTextAlignment="Center"
                           Opacity="0.9" />
                </VerticalStackLayout>
            </Border>

            <!-- 冲突角标 -->
            <Border WidthRequest="48" HeightRequest="48"
                    Margin="0,0,0,12"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    TranslationX="-8"
                    BackgroundColor="{DynamicResource PanelBackground}"
                    Stroke="{DynamicResource Border}"
                    StrokeThickness="1"
                    IsVisible="{Binding IsPaired}"
                    SemanticProperties.Description="冲突">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenConflictsCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                    <Label Text="!"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AccentForeground}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ConflictBadgeText}"
                           FontSize="11"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 车站角标 -->
            <Border WidthRequest="48" HeightRequest="48"
                    Margin="0,0,0,12"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    TranslationX="8"
                    BackgroundColor="{DynamicResource PanelBackground}"
                    Stroke="{DynamicResource Border}"
                    StrokeThickness="1"
                    IsVisible="{Binding IsPaired}"
                    SemanticProperties.Description="车站库">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenStationsCommand}" />
                </Border.GestureRecognizers>
                <Label Text="站"
                       FontSize="16"
                       TextColor="{DynamicResource AccentForeground}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- 球下提示：单独一行，避免被球挡住 -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="End"
                             Margin="0,0,0,4"
                             Spacing="2">
            <Label Text="{Binding CenterHint}"
                   FontSize="{DynamicResource SmallFontSize}"
                   TextColor="{DynamicResource AccentForeground}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
            <Label Text="{Binding ShortHost, StringFormat='当前地址 {0}'}"
                   FontSize="{DynamicResource SmallFontSize}"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding IsPaired, Converter={StaticResource InvertedBoolConverter}}"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>

        <!-- 底栏 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10" HeightRequest="56">
            <!-- 未配对：地址 + 扫码 -->
            <Border IsVisible="{Binding IsPaired, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{DynamicResource PanelBackground}"
                    Stroke="{DynamicResource AccentForeground}"
                    StrokeThickness="1"
                    Padding="14,0"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddressActionsCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding FooterPrimary}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       TextColor="{DynamicResource TextPrimary}"
                       FontAttributes="Bold" />
            </Border>

            <Button Grid.Column="1"
                    IsVisible="{Binding IsPaired, Converter={StaticResource InvertedBoolConverter}}"
                    WidthRequest="72" HeightRequest="56"
                    CornerRadius="28"
                    Padding="4,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding OpenScanCommand}"
                    SemanticProperties.Description="扫码"
                    Text="扫码"
                    FontSize="16" />

            <!-- 已配对：连接行 → 设置 -->
            <Border Grid.ColumnSpan="2"
                    IsVisible="{Binding IsPaired}"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="4,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenConnectionCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding FooterPrimary}"
                           FontSize="{DynamicResource SmallFontSize}"
                           TextColor="{DynamicResource TextSecondary}"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="设置"
                               FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{DynamicResource AccentForeground}" />
                        <Label Text="›"
                               FontSize="14"
                               TextColor="{DynamicResource AccentForeground}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
