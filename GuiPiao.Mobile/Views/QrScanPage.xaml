<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             x:Class="GuiPiao.Mobile.Views.QrScanPage"
             Title="扫码连接"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False">

    <Grid>
        <scanner:CameraView x:Name="CameraView"
                            CameraEnabled="False"
                            AimMode="False"
                            ViewfinderMode="True"
                            VibrationOnDetected="True"
                            CaptureQuality="Medium"
                            BarcodeSymbologies="QRCode"
                            OnDetectionFinished="OnDetectionFinished"
                            VerticalOptions="Fill"
                            HorizontalOptions="Fill" />

        <!-- 取景框（仅装饰，不挡触摸） -->
        <Border WidthRequest="240" HeightRequest="240"
                Stroke="White" StrokeThickness="2"
                BackgroundColor="Transparent"
                InputTransparent="True"
                HorizontalOptions="Center" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
        </Border>

        <VerticalStackLayout VerticalOptions="End" Padding="16,12,16,28" Spacing="6">
            <Label Text="对准 PC 同步二维码，自动识别"
                   TextColor="#CCFFFFFF"
                   HorizontalTextAlignment="Center"
                   FontSize="{DynamicResource SmallFontSize}" />
            <Label x:Name="StatusLabel"
                   TextColor="#99FFFFFF"
                   HorizontalTextAlignment="Center"
                   FontSize="{DynamicResource SmallFontSize}"
                   LineBreakMode="WordWrap" />
            <Label Text="从相册选图"
                   TextColor="#CCFFFFFF"
                   HorizontalTextAlignment="Center"
                   Padding="12,10"
                   FontSize="{DynamicResource SmallFontSize}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAlbumClicked" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
