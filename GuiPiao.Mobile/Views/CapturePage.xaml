<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:GuiPiao.Mobile.Icons"
             xmlns:vm="clr-namespace:GuiPiao.Mobile.ViewModels"
             x:Class="GuiPiao.Mobile.Views.CapturePage"
             x:DataType="vm:CaptureViewModel"
             Title="采集"
             BackgroundColor="{DynamicResource WindowBackground}">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12" RowSpacing="10">
        <Label Text="采集"
               FontSize="{DynamicResource TitleFontSize}"
               FontAttributes="Bold" />

        <Editor Grid.Row="1"
                Text="{Binding PasteText}"
                Placeholder="粘贴短信 / 订单 / 票面文本…"
                AutoSize="Disabled"
                VerticalOptions="Fill"
                BackgroundColor="{DynamicResource ControlBackground}" />

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label Text="{Binding StatusText}"
                   FontSize="{DynamicResource SmallFontSize}"
                   TextColor="{DynamicResource TextSecondary}"
                   LineBreakMode="WordWrap" />
            <Button Text="识别并预填"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="48"
                    Command="{Binding ParsePasteCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Text="拍照"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HeightRequest="44" Padding="4,0"
                        Command="{Binding TakePhotoCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                <Button Grid.Column="1"
                        Text="相册"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HeightRequest="44" Padding="4,0"
                        Command="{Binding PickPhotoCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                <Button Grid.Column="2"
                        Text="粘贴"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HeightRequest="44" Padding="8,0"
                        Command="{Binding PasteFromClipboardCommand}" />
                <Button Grid.Column="3"
                        Text="空白"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HeightRequest="44" Padding="8,0"
                        Command="{Binding OpenBlankFormCommand}" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource AccentColor}"
                               HeightRequest="24" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
