<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:GuiPiao.Mobile.Model"
             xmlns:vm="clr-namespace:GuiPiao.Mobile.ViewModels"
             x:Class="GuiPiao.Mobile.Views.TripsPage"
             x:DataType="vm:TripsViewModel"
             x:Name="TripsRoot"
             Title="行程"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WindowBackground}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,12" RowSpacing="10">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border Stroke="{DynamicResource Border}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource ControlBackground}"
                    Padding="10,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <Entry Placeholder="搜索车次 / 车站 / 日期"
                       Text="{Binding SearchText}"
                       BackgroundColor="Transparent" />
            </Border>
            <Button Grid.Column="1"
                    Text="标签"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    Command="{Binding OpenTagsCommand}"
                    SemanticProperties.Description="管理标签" />
        </Grid>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6">
                <Button Text="全部" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" HeightRequest="34"
                        Command="{Binding SetStatusFilterCommand}" CommandParameter="-1" />
                <Button Text="未出行" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" HeightRequest="34"
                        Command="{Binding SetStatusFilterCommand}" CommandParameter="0" />
                <Button Text="已完成" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" HeightRequest="34"
                        Command="{Binding SetStatusFilterCommand}" CommandParameter="1" />
                <Button Text="已改签" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" HeightRequest="34"
                        Command="{Binding SetStatusFilterCommand}" CommandParameter="2" />
                <Button Text="已退票" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" HeightRequest="34"
                        Command="{Binding SetStatusFilterCommand}" CommandParameter="3" />
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None"
                            IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:MobileRide">
                        <VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
                            <Grid Padding="0,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="2" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference TripsRoot}, Path=BindingContext.OpenDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{Binding TrainNo}"
                                       FontSize="{DynamicResource TitleFontSize}"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AccentForeground}" />
                                <Label Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       FontSize="{DynamicResource SmallFontSize}"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding RouteText}" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2"
                                       Text="{Binding WhenText}"
                                       FontSize="{DynamicResource SmallFontSize}"
                                       TextColor="{DynamicResource TextSecondary}" />
                                <Label Grid.Row="2" Grid.Column="1"
                                       Text="{Binding TagsText}"
                                       FontSize="{DynamicResource SmallFontSize}"
                                       TextColor="{DynamicResource AccentForeground}"
                                       HorizontalTextAlignment="End"
                                       IsVisible="{Binding HasTags}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 Spacing="8"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <Label Text="暂无行程"
                       FontSize="{DynamicResource TitleFontSize}"
                       HorizontalOptions="Center" />
                <Label Text="{Binding StatusText}"
                       TextColor="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource SmallFontSize}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Button Text="去同步"
                        Style="{StaticResource PrimaryButtonStyle}"
                        WidthRequest="140"
                        HorizontalOptions="Center"
                        Clicked="OnGoSyncClicked" />
            </VerticalStackLayout>

            <!-- FAB：新增行程，叠在列表右下，不挡底栏与分页 -->
            <Button Text="＋"
                    Style="{StaticResource PrimaryButtonStyle}"
                    WidthRequest="56" HeightRequest="56"
                    CornerRadius="28"
                    Padding="0"
                    FontSize="28"
                    FontAttributes="Bold"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,4,16"
                    Command="{Binding AddCommand}"
                    SemanticProperties.Description="添加行程" />
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8"
              IsVisible="{Binding ShowPager}"
              Padding="0,4,0,0">
            <Button Text="‹"
                    Style="{StaticResource SecondaryButtonStyle}"
                    WidthRequest="44" HeightRequest="40" Padding="0"
                    FontSize="20"
                    Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}" />
            <Label Grid.Column="1"
                   Text="{Binding PageText}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="{DynamicResource SmallFontSize}"
                   TextColor="{DynamicResource TextSecondary}" />
            <Button Grid.Column="2"
                    Text="›"
                    Style="{StaticResource SecondaryButtonStyle}"
                    WidthRequest="44" HeightRequest="40" Padding="0"
                    FontSize="20"
                    Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}" />
        </Grid>
    </Grid>
</ContentPage>
