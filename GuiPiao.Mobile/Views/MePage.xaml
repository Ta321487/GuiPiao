<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:GuiPiao.Mobile.Icons"
             xmlns:vm="clr-namespace:GuiPiao.Mobile.ViewModels"
             x:Class="GuiPiao.Mobile.Views.MePage"
             x:DataType="vm:MeViewModel"
             Title="我的"
             BackgroundColor="{DynamicResource WindowBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="0">
            <Label Text="我的"
                   FontSize="{DynamicResource TitleFontSize}"
                   FontAttributes="Bold"
                   Margin="0,0,0,12" />

            <Label Text="{Binding StatsText}"
                   TextColor="{DynamicResource TextSecondary}"
                   Margin="0,0,0,4" />
            <CollectionView ItemsSource="{Binding YearStats}"
                            HeightRequest="72"
                            Margin="0,0,0,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}"
                               FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{DynamicResource TextSecondary}"
                               Margin="0,2" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
            <Grid Padding="0,14" ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTagsCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="标签" VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="›"
                       TextColor="{DynamicResource TextSecondary}"
                       VerticalOptions="Center"
                       FontSize="18" />
            </Grid>

            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
            <Label Text="外观"
                   FontAttributes="Bold"
                   Margin="0,14,0,8"
                   TextColor="{DynamicResource TextSecondary}"
                   FontSize="{DynamicResource SmallFontSize}" />
            <Grid ColumnDefinitions="100,*" ColumnSpacing="8" Margin="0,0,0,10">
                <Label Text="主题" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding ThemeModes}"
                        SelectedItem="{Binding ThemeMode}"
                        Title="主题" />
            </Grid>
            <Grid ColumnDefinitions="100,*" ColumnSpacing="8" Margin="0,0,0,10">
                <Label Text="强调色" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding AccentColors}"
                        SelectedItem="{Binding AccentColor}"
                        Title="强调色" />
            </Grid>
            <Entry Text="{Binding CustomColor}"
                   Placeholder="#0078D4"
                   Margin="0,0,0,10"
                   IsVisible="{Binding AccentColor, Converter={StaticResource IsCustomAccentConverter}}" />
            <Button Text="应用外观"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ApplyAppearanceCommand}"
                    HeightRequest="40"
                    Margin="0,0,0,8" />

            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
            <Grid Padding="0,14" ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenConnectionCommand}" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout>
                    <Label Text="连接" />
                    <Label Text="{Binding BaseUrl}"
                           FontSize="{DynamicResource SmallFontSize}"
                           TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       Text="›"
                       TextColor="{DynamicResource TextSecondary}"
                       VerticalOptions="Center"
                       FontSize="18" />
            </Grid>

            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
            <VerticalStackLayout Padding="0,14" Spacing="4">
                <Label Text="关于 GuiPiao" />
                <Label Text="手机端 · 采集与随身查看 · PC 为权威库"
                       FontSize="{DynamicResource SmallFontSize}"
                       TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   TextColor="{DynamicResource AccentForeground}"
                   FontSize="{DynamicResource SmallFontSize}"
                   Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
