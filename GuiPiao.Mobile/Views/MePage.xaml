<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:GuiPiao.Mobile.Icons"
             xmlns:vm="clr-namespace:GuiPiao.Mobile.ViewModels"
             xmlns:model="clr-namespace:GuiPiao.Mobile.Model"
             x:Class="GuiPiao.Mobile.Views.MePage"
             x:Name="MeRoot"
             x:DataType="vm:MeViewModel"
             Title="我的"
             BackgroundColor="{DynamicResource WindowBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="0">
            <Label Text="我的"
                   FontSize="{DynamicResource TitleFontSize}"
                   FontAttributes="Bold"
                   Margin="0,0,0,12" />

            <Label Text="{Binding StatsText}"
                   TextColor="{DynamicResource TextSecondary}"
                   Margin="0,0,0,4" />
            <CollectionView ItemsSource="{Binding YearStats}"
                            HeightRequest="72"
                            Margin="0,0,0,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}"
                               FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{DynamicResource TextSecondary}"
                               Margin="0,2" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
            <Grid Padding="0,14" ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTagsCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="标签" VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="›"
                       TextColor="{DynamicResource TextSecondary}"
                       VerticalOptions="Center"
                       FontSize="18" />
            </Grid>

            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
            <Label Text="外观"
                   FontAttributes="Bold"
                   Margin="0,14,0,8"
                   TextColor="{DynamicResource TextSecondary}"
                   FontSize="{DynamicResource SmallFontSize}" />

            <Label Text="主题模式"
                   Margin="0,0,0,6"
                   TextColor="{DynamicResource TextPrimary}" />
            <FlexLayout BindableLayout.ItemsSource="{Binding ThemeModeOptions}"
                        Wrap="Wrap"
                        Margin="0,0,0,12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="model:ThemeModeOption">
                        <Border Margin="0,0,8,8"
                                Padding="12,8"
                                Stroke="{DynamicResource Border}"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource BoolToStrokeThicknessConverter}}"
                                BackgroundColor="{DynamicResource PanelBackground}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource AccentForeground}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference MeRoot}, Path=BindingContext.SelectThemeModeCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Title}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="强调色（主题色）"
                   Margin="0,0,0,6"
                   TextColor="{DynamicResource TextPrimary}" />
            <FlexLayout BindableLayout.ItemsSource="{Binding AccentColorOptions}"
                        Wrap="Wrap"
                        Margin="0,0,0,8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="model:AccentColorOption">
                        <Border Margin="0,0,8,8"
                                Padding="10,8"
                                Stroke="{DynamicResource Border}"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource BoolToStrokeThicknessConverter}}"
                                BackgroundColor="{DynamicResource PanelBackground}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource AccentForeground}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference MeRoot}, Path=BindingContext.SelectAccentColorCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8">
                                <BoxView WidthRequest="16"
                                         HeightRequest="16"
                                         Color="{Binding Swatch}"
                                         VerticalOptions="Center"
                                         CornerRadius="2" />
                                <Label Text="{Binding Title}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <VerticalStackLayout IsVisible="{Binding IsCustomAccent}"
                                 Spacing="8"
                                 Margin="0,0,0,8"
                                 Padding="0,4,0,0">
                <Label Text="自定义颜色"
                       TextColor="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource SmallFontSize}" />
                <HorizontalStackLayout Spacing="10">
                    <BoxView WidthRequest="48"
                             HeightRequest="32"
                             Color="{Binding CustomPreview}"
                             CornerRadius="4"
                             VerticalOptions="Center" />
                    <Entry Text="{Binding CustomColor}"
                           Placeholder="#0078D4"
                           WidthRequest="120"
                           VerticalOptions="Center"
                           Keyboard="Text"
                           MaxLength="9" />
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="28,*,48" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <Label Text="R" VerticalOptions="Center" TextColor="{DynamicResource TextPrimary}" />
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="255"
                            Value="{Binding CustomRed}"
                            VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="{Binding CustomRed, StringFormat='{0:0}'}"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="End"
                           TextColor="{DynamicResource TextSecondary}" />

                    <Label Grid.Row="1" Text="G" VerticalOptions="Center" TextColor="{DynamicResource TextPrimary}" />
                    <Slider Grid.Row="1"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="255"
                            Value="{Binding CustomGreen}"
                            VerticalOptions="Center" />
                    <Label Grid.Row="1"
                           Grid.Column="2"
                           Text="{Binding CustomGreen, StringFormat='{0:0}'}"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="End"
                           TextColor="{DynamicResource TextSecondary}" />

                    <Label Grid.Row="2" Text="B" VerticalOptions="Center" TextColor="{DynamicResource TextPrimary}" />
                    <Slider Grid.Row="2"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="255"
                            Value="{Binding CustomBlue}"
                            VerticalOptions="Center" />
                    <Label Grid.Row="2"
                           Grid.Column="2"
                           Text="{Binding CustomBlue, StringFormat='{0:0}'}"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="End"
                           TextColor="{DynamicResource TextSecondary}" />
                </Grid>

                <Label Text="色板"
                       TextColor="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource SmallFontSize}"
                       Margin="0,4,0,0" />
                <FlexLayout BindableLayout.ItemsSource="{Binding CustomColorPresets}"
                            Wrap="Wrap">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="model:CustomColorSwatch">
                            <Border Margin="0,0,6,6"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Stroke="{DynamicResource Border}"
                                    StrokeThickness="1"
                                    BackgroundColor="{Binding Color}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference MeRoot}, Path=BindingContext.PickCustomPresetCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <Label Text="切换后即时生效并保存"
                   FontSize="{DynamicResource SmallFontSize}"
                   TextColor="{DynamicResource TextSecondary}"
                   Margin="0,0,0,8" />

            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
            <Grid Padding="0,14" ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenConnectionCommand}" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout>
                    <Label Text="连接" />
                    <Label Text="{Binding BaseUrl}"
                           FontSize="{DynamicResource SmallFontSize}"
                           TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       Text="›"
                       TextColor="{DynamicResource TextSecondary}"
                       VerticalOptions="Center"
                       FontSize="18" />
            </Grid>

            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
            <VerticalStackLayout Padding="0,14" Spacing="4">
                <Label Text="关于 GuiPiao" />
                <Label Text="手机端 · 采集与随身查看 · PC 为权威库"
                       FontSize="{DynamicResource SmallFontSize}"
                       TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   TextColor="{DynamicResource AccentForeground}"
                   FontSize="{DynamicResource SmallFontSize}"
                   Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
