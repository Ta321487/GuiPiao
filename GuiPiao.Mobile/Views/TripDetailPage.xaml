<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:GuiPiao.Mobile.Icons"
             xmlns:vm="clr-namespace:GuiPiao.Mobile.ViewModels"
             x:Class="GuiPiao.Mobile.Views.TripDetailPage"
             x:DataType="vm:TripDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource WindowBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16,12" Spacing="0">
                <Label Text="行程不存在或已删除"
                       IsVisible="{Binding HasRide, Converter={StaticResource InvertedBoolConverter}}"
                       TextColor="{DynamicResource TextSecondary}"
                       Margin="0,24" />

                <VerticalStackLayout IsVisible="{Binding HasRide}" Spacing="0">
                    <!-- 上半：摘要构图 -->
                    <Label Text="{Binding Ride.TrainNoDisplay}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AccentForeground}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Ride.StatusText}"
                           FontSize="{DynamicResource SmallFontSize}"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalTextAlignment="Center"
                           Margin="0,2,0,10" />
                    <Label Text="{Binding Ride.RouteText}"
                           FontSize="{DynamicResource TitleFontSize}"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Ride.WhenText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,4,0,0" />
                    <Label Text="{Binding Ride.CoachSeatText}"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource TextSecondary}"
                           Margin="0,2,0,0" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Margin="0,4,0,16">
                        <Label Text="{Binding Ride.MoneyDisplay}" TextColor="{DynamicResource AccentForeground}" />
                        <Label Text="{Binding Ride.SeatTypeDisplay}" TextColor="{DynamicResource TextSecondary}" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0,0,0,10" />

                    <!-- 下半：两列密排（须声明 RowDefinitions，否则部分平台行会叠在一起） -->
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="车票号码" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="{Binding Ride.TicketNumberDisplay}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="检票口" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="{Binding Ride.CheckInLocationDisplay}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Spacing="2">
                            <Label Text="出发" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="{Binding Ride.DepartStationDisplay}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Text="到达" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="{Binding Ride.ArriveStationDisplay}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Spacing="2">
                            <Label Text="日期" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="{Binding Ride.DepartDateDisplay}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                            <Label Text="到时" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="{Binding Ride.ArriveTimeDisplay}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="3" Spacing="2">
                            <Label Text="用途" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="{Binding Ride.TicketPurposeDisplay}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="2">
                            <Label Text="改签" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="{Binding Ride.TicketModificationTypeDisplay}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="票底提示"
                           FontSize="{DynamicResource SmallFontSize}"
                           TextColor="{DynamicResource TextSecondary}"
                           Margin="0,12,0,2" />
                    <Label Text="{Binding Ride.HintDisplay}" Margin="0,0,0,8" />

                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0,4" />
                    <Grid Padding="0,12" ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleMoreCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="其他" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding MoreChevron}"
                               FontFamily="{x:Static icons:AppIcons.FontFamilyName}"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout IsVisible="{Binding ShowMore}" Spacing="6" Margin="0,0,0,8">
                        <Label Text="{Binding Ride.DepartStationPinyinDisplay, StringFormat='出发拼音  {0}'}"
                               FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="{Binding Ride.ArriveStationPinyinDisplay, StringFormat='到达拼音  {0}'}"
                               FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="{Binding Ride.DepartStationCodeDisplay, StringFormat='出发代码  {0}'}"
                               FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="{Binding Ride.ArriveStationCodeDisplay, StringFormat='到达代码  {0}'}"
                               FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="{Binding Ride.AdditionalInfoDisplay, StringFormat='附加信息  {0}'}"
                               FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,12" Spacing="8"
                             IsVisible="{Binding HasRide}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="编辑" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding EditCommand}" HeightRequest="44" />
                <Button Grid.Column="1" Text="票面" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PreviewFaceCommand}" HeightRequest="44" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding CanRefundOrReschedule}">
                <Button Text="改签" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RescheduleCommand}" HeightRequest="40" />
                <Button Grid.Column="1" Text="退票" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefundCommand}" HeightRequest="40" />
            </Grid>
            <Button Text="删除"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource TextSecondary}"
                    Command="{Binding DeleteCommand}"
                    HeightRequest="36" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
