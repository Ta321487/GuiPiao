<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GuiPiao.Mobile.Views"
       x:Class="GuiPiao.Mobile.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="GuiPiao">

    <!-- Tab 标题用文字；图标字形见各页（Segoe MDL2，Windows 预览可用） -->
    <TabBar>
        <ShellContent Title="行程"
                      ContentTemplate="{DataTemplate views:TripsPage}"
                      Route="trips" />
        <ShellContent Title="采集"
                      ContentTemplate="{DataTemplate views:CapturePage}"
                      Route="capture" />
        <ShellContent Title="同步"
                      ContentTemplate="{DataTemplate views:SyncPage}"
                      Route="sync" />
        <ShellContent Title="设置"
                      ContentTemplate="{DataTemplate views:MePage}"
                      Route="me" />
    </TabBar>
</Shell>
